# ── GİRİŞ ──────────────────────────────────────────────────────────────
# Panel şifresi. Vercel'de mutlaka güçlü bir değer girin.
# Boş bırakılırsa üretimde giriş güvenlik gereği kapalı kalır.
ADMIN_PASSWORD=

# Oturum imzası için rastgele uzun anahtar (openssl rand -base64 32).
# Boş bırakılırsa ADMIN_PASSWORD'dan türetilir.
ADMIN_SECRET=

# Panelin gizli adresi. /admin DEĞİL, tahmin edilmesi zor bir yol seçin.
ADMIN_PATH=/studio-7f3k9

# ── İÇERİK DEPOLAMA ────────────────────────────────────────────────────
# Vercel projesine Blob store bağlayınca otomatik eklenir.
# Panelden yapılan tüm değişiklikler ve görseller burada saklanır.
BLOB_READ_WRITE_TOKEN=

# ── SİTE ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.aligstudio.com

# ── İLETİŞİM FORMU (opsiyonel) ─────────────────────────────────────────
# Resend hesabı bağlarsanız form mesajları e-posta olarak gelir.
RESEND_API_KEY=
CONTACT_TO_EMAIL=merhaba@aligstudio.com
CONTACT_FROM_EMAIL=ALIG Studio <onboarding@resend.dev>

# Alternatif: Vercel Blob yerine GitHub deposu (ucretsiz, kota yok).
# Fine-grained PAT (yalnızca bu repo, Contents: Read+Write) — Sensitive/Production-only.
GITHUB_STORAGE_TOKEN=
